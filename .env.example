# 백엔드 REST 베이스 URL (vite proxy 대상)
VITE_API_URL=http://localhost:8080

# 실시간 협업 WebSocket 베이스 URL
# 비워두면 브라우저 origin 기준 wss://{host} 로 자동 결정
VITE_WS_URL=ws://localhost:8080

# 실시간 동기화 서버(whiteboard-socket) URL.
# 설정 시 이 주소로 y-websocket 접속(room=boardId 가 뒤에 붙는다 → /ws/boards/{boardId}).
# - 로컬에서 분리된 소켓 서버를 직접 띄웠다면: ws://localhost:8081/ws/boards
# - 운영: wss://wb.gpglab.site/ws/boards (인그레스가 /ws → whiteboard-socket 으로 라우팅)
# 미설정이면 로컬 IDB 영속화만 사용(단독 편집).
VITE_SYNC_WS_URL=ws://localhost:8081/ws/boards
